# Local port published by Docker Compose.
PEGARR_PORT=8080

# Use a version tag for repeatable NAS deployments once releases exist.
PEGARR_IMAGE=ghcr.io/squiter/pegarr:latest

# Used only for timestamps shown by the container.
TZ=UTC

# Successful subtitle-provider searches are cached in the private data volume.
# Failures and quota responses are never cached.
PEGARR_PROVIDER_CACHE_TTL_SECONDS=900
PEGARR_PROVIDER_CACHE_MAX_ENTRIES=5000

# Optional authenticated read-only library API. Generate a random token of at
# least 32 characters and store it in this private host file, never in .env.
# PEGARR_ACCESS_TOKEN_HOST_FILE=/absolute/private/path/pegarr_access_token
PEGARR_MISSING_PAGE_SIZE=50

# Optional Sonarr read-only status probe. Keep the API key itself out of this file.
# PEGARR_SONARR_URL=http://sonarr:8989
# PEGARR_SONARR_ALLOWED_HOSTS=sonarr
# PEGARR_SONARR_INSTANCE_ID=sonarr
# PEGARR_SONARR_ALLOW_INSECURE_HTTP=true
# PEGARR_SONARR_API_KEY_HOST_FILE=/absolute/private/path/sonarr_api_key
# Alternative for multiple Sonarr instances; do not combine with the settings above.
# PEGARR_SONARR_INSTANCES_HOST_FILE=/absolute/private/path/sonarr-instances.json
# PEGARR_SONARR_API_KEYS_HOST_DIR=/absolute/private/path/pegarr-sonarr-keys

# Optional Radarr read-only status probe. Keep the API key itself out of this file.
# PEGARR_RADARR_URL=http://radarr:7878
# PEGARR_RADARR_ALLOWED_HOSTS=radarr
# PEGARR_RADARR_INSTANCE_ID=radarr
# PEGARR_RADARR_ALLOW_INSECURE_HTTP=true
# PEGARR_RADARR_API_KEY_HOST_FILE=/absolute/private/path/radarr_api_key
# Alternative for multiple Radarr instances; do not combine with the settings above.
# PEGARR_RADARR_INSTANCES_HOST_FILE=/absolute/private/path/radarr-instances.json
# PEGARR_RADARR_API_KEYS_HOST_DIR=/absolute/private/path/pegarr-radarr-keys

# Optional Bazarr read-only language-profile probe. Keep the API key itself out of this file.
# PEGARR_BAZARR_URL=http://bazarr:6767
# PEGARR_BAZARR_ALLOWED_HOSTS=bazarr
# PEGARR_BAZARR_INSTANCE_ID=bazarr
# PEGARR_BAZARR_ALLOW_INSECURE_HTTP=true
# PEGARR_BAZARR_API_KEY_HOST_FILE=/absolute/private/path/bazarr_api_key

# Optional one-shot SubDL exact-search probe. Keep the API key itself out of this file.
# The identifier and language mapping are required only when running probe:subdl.
# PEGARR_SUBDL_URL=https://api.subdl.com
# PEGARR_SUBDL_ALLOWED_HOSTS=api.subdl.com
# PEGARR_SUBDL_INSTANCE_ID=subdl
# PEGARR_SUBDL_API_KEY_HOST_FILE=/absolute/private/path/subdl_api_key
# PEGARR_SUBDL_LANGUAGE_MAPPINGS=en:EN,pt-BR:PT-BR
# PEGARR_SUBDL_PROBE_KIND=episode
# PEGARR_SUBDL_PROBE_IMDB_ID=tt1234567
# PEGARR_SUBDL_PROBE_TMDB_ID=
# PEGARR_SUBDL_PROBE_POLICY_LANGUAGE=en
# PEGARR_SUBDL_PROBE_PROVIDER_LANGUAGE=EN
# PEGARR_SUBDL_PROBE_SEASON=1
# PEGARR_SUBDL_PROBE_EPISODE=1
# PEGARR_OPENSUBTITLES_API_KEY_HOST_FILE=/absolute/private/path/opensubtitles_api_key
