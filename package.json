{
  "name": "pegarr",
  "version": "0.1.0",
  "private": true,
  "description": "Subtitle-aware release selection for Sonarr and Radarr.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "test": "node --test dist/*.test.js",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
