{
  "name": "pegarr",
  "version": "0.1.1",
  "private": true,
  "description": "Subtitle-aware release selection for Sonarr and Radarr.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node src/copy-web.mjs",
    "start": "node dist/index.js",
    "probe:sonarr": "node dist/probe-sonarr.js",
    "probe:radarr": "node dist/probe-radarr.js",
    "probe:bazarr": "node dist/probe-bazarr.js",
    "probe:subdl": "node dist/probe-subdl.js",
    "probe:opensubtitles": "node dist/probe-opensubtitles.js",
    "report:sonarr-episode": "node dist/report-sonarr-episode.js",
    "report:sonarr-season": "node dist/report-sonarr-season.js",
    "report:radarr-movie": "node dist/report-radarr-movie.js",
    "inventory:missing": "node dist/inventory-missing.js",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --test --test-concurrency=1 scripts/harness/*.test.mjs dist/*.test.js dist/**/*.test.js",
    "typecheck": "tsc --noEmit",
    "check:fast": "node scripts/harness/run-checks.mjs fast",
    "check:affected": "node scripts/harness/run-checks.mjs affected",
    "check": "node scripts/harness/run-checks.mjs full"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
