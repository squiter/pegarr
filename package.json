{
  "name": "pegarr",
  "version": "0.1.0",
  "private": true,
  "description": "Subtitle-aware release selection for Sonarr and Radarr.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --test --test-concurrency=1 scripts/harness/*.test.mjs dist/*.test.js",
    "typecheck": "tsc --noEmit",
    "check:fast": "node scripts/harness/run-checks.mjs fast",
    "check:affected": "node scripts/harness/run-checks.mjs affected",
    "check": "node scripts/harness/run-checks.mjs full"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
